#!/bin/sh
# This repo keeps a linear history. `merge.ff = only` covers the ordinary path,
# but an explicit `--no-ff` overrides config, so refuse here as well.
echo "refusing: this repo has a linear history, no merge commits." >&2
echo "rebase instead:  git rebase main <branch> && git checkout main && git merge --ff-only <branch>" >&2
exit 1
